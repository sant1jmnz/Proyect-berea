# Copiá este archivo como .env y completá los valores (cada uno con: openssl rand -hex 32).
# El .env real NO se sube a Git.
#
# DERMALIA_SECRETO_SESIONES: firma de las sesiones. Si se cambia, solo se cierran las sesiones abiertas.
DERMALIA_SECRETO_SESIONES=
#
# Asistente de IA (Gemini). La clave se saca gratis en https://aistudio.google.com/apikey
# Sin clave el asistente responde igual, con las respuestas locales (catálogo y reglas del instituto).
GEMINI_API_KEY=
# Modelo (opcional). Por defecto gemini-flash-lite-latest; si falla se prueba gemini-flash-latest.
GEMINI_MODELO=
#
# WhatsApp del instituto, con código de país y sin "+" (ej. 5491123456789). Se usa al armar el sitio (npm run build).
VITE_WHATSAPP_INSTITUTO=
#
# Base de datos que usa la API (las mismas variables que las apps de escritorio).
DERMALIA_DB_HOST=127.0.0.1
DERMALIA_DB_PORT=3306
DERMALIA_DB_USER=
DERMALIA_DB_PASS=
# 1 para Aiven (conexión cifrada)
DERMALIA_DB_SSL=
#
# Bot de Telegram. El token se crea con @BotFather (/newbot). Sin token el bot queda apagado.
TELEGRAM_BOT_TOKEN=
# Vacío: la API manda los avisos. n8n: los manda n8n y la API solo conversa con la paciente.
TELEGRAM_ENVIOS=
# Vacío: las tareas diarias (3 a.m.) las hace la API. n8n: las hace n8n.
TAREAS_DIARIAS=
