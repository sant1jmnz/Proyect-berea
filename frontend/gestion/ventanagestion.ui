  <property name="windowTitle">
   <string>Dermalia — Sistema de Turnos (Gestión)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget { font-family: &quot;Ubuntu&quot;, &quot;Noto Sans&quot;, &quot;DejaVu Sans&quot;, sans-serif; font-size: 13px; color: #111827; }
QWidget#central { background: #f6f7f9; }

/* ---- barra lateral ---- */
QFrame#barraLateral { background: #2a0f1f; }
QLabel#lblMarca { color: #ffffff; font-size: 20px; font-weight: 700; }
QLabel#lblSubmarca { color: #c9a9b8; font-size: 11px; }
QListWidget#menu { background: transparent; border: none; outline: 0; }
QListWidget#menu::item { padding: 10px 12px; border-radius: 8px; color: #e7d3dc; margin-bottom: 3px; }
QListWidget#menu::item:hover { background: #3d1a2d; }
QListWidget#menu::item:selected { background: #d6136c; color: #ffffff; }
QPushButton#btnAyuda { background: transparent; border: 1px solid #5a2c42; color: #e7d3dc; }
QPushButton#btnAyuda:hover { background: #3d1a2d; }

/* ---- textos ---- */
QLabel[rol=&quot;titulo&quot;] { font-size: 22px; font-weight: 700; }
QLabel[rol=&quot;subtitulo&quot;] { color: #6b7280; }
QLabel[rol=&quot;seccion&quot;] { font-size: 14px; font-weight: 700; }
QLabel[rol=&quot;campo&quot;] { color: #6b7280; font-size: 11px; font-weight: 700; }
QLabel[rol=&quot;valor&quot;] { font-weight: 600; }
QLabel[rol=&quot;nota&quot;] { color: #6b7280; font-size: 12px; }
QLabel[rol=&quot;numero&quot;] { font-size: 30px; font-weight: 700; color: #d6136c; }

/* ---- indicador de pasos ---- */
QLabel[paso=&quot;activo&quot;] { background: #d6136c; color: #ffffff; border-radius: 11px; padding: 4px 14px; font-size: 12px; font-weight: 700; }
QLabel[paso=&quot;hecho&quot;] { background: #fbe4ee; color: #b80f5c; border-radius: 11px; padding: 4px 14px; font-size: 12px; font-weight: 700; }
QLabel[paso=&quot;pendiente&quot;] { background: #eceef2; color: #6b7280; border-radius: 11px; padding: 4px 14px; font-size: 12px; font-weight: 700; }

/* ---- tarjetas ---- */
QFrame[tarjeta=&quot;true&quot;] { background: #ffffff; border: 1px solid #e6e8ee; border-radius: 12px; }
QFrame#tarjetaSena { background: #eef3ff; border: 1px solid #c7d7fb; }
QLabel#lblSena { font-size: 28px; font-weight: 700; color: #2563eb; }
QLabel#lblRecordatorio { color: #8f0c48; background: #fdf2f6; border-radius: 8px; padding: 8px 12px; }

/* ---- campos y botones ---- */
QLineEdit { border: 1px solid #e6e8ee; border-radius: 8px; padding: 8px 11px; background: #f9fafb; }
QLineEdit:focus { border-color: #d6136c; background: #ffffff; }
QPushButton { border: 1px solid #d9dce3; border-radius: 8px; padding: 9px 16px; font-weight: 600; background: #ffffff; }
QPushButton:hover { background: #f6f7f9; }
QPushButton[primario=&quot;true&quot;] { background: #d6136c; border-color: #d6136c; color: #ffffff; }
QPushButton[primario=&quot;true&quot;]:hover { background: #b80f5c; border-color: #b80f5c; }
QPushButton[peligro=&quot;true&quot;] { color: #b91c1c; border-color: #f3c2c2; }
QPushButton[peligro=&quot;true&quot;]:hover { background: #fef2f2; }
QPushButton[grande=&quot;true&quot;] { padding: 15px 16px; font-size: 14px; text-align: left; }
QPushButton#btnSena { background: #2563eb; border-color: #2563eb; color: #ffffff; }
QPushButton#btnSena:checked { background: #16a34a; border-color: #16a34a; }
QPushButton:disabled { background: #eceef2; border-color: #e6e8ee; color: #9ca3af; }

/* ---- listas ---- */
QListWidget#listaProtocolos, QListWidget#listaHorarios, QListWidget#listaProximos { border: none; outline: 0; background: #ffffff; }
QListWidget#listaProtocolos::item { border: 1px solid #e6e8ee; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
QListWidget#listaProtocolos::item:hover { border-color: #f0a9c8; }
QListWidget#listaProtocolos::item:selected { border-color: #d6136c; background: #fdf2f6; color: #111827; }
QListWidget#listaHorarios::item { border: 1px solid #e6e8ee; border-radius: 8px; padding: 11px 24px; margin-right: 8px; margin-bottom: 8px; font-weight: 600; }
QListWidget#listaHorarios::item:hover { border-color: #a9c0f5; }
QListWidget#listaHorarios::item:selected { border-color: #2563eb; background: #eef3ff; color: #2563eb; }
QListWidget#listaProximos::item { padding: 9px 2px; border-bottom: 1px solid #f0f1f4; }

/* ---- calendario ---- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #ffffff; }
QCalendarWidget QToolButton { color: #111827; font-weight: 700; background: transparent; border: none; border-radius: 6px; padding: 4px 8px; }
QCalendarWidget QToolButton:hover { background: #fdf2f6; }
QCalendarWidget QAbstractItemView { background: #ffffff; alternate-background-color: #ffffff; selection-background-color: #d6136c; selection-color: #ffffff; outline: 0; border: none; }
QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: none; qproperty-text: &quot;‹&quot;; font-size: 20px; }
QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: none; qproperty-text: &quot;›&quot;; font-size: 20px; }
QCalendarWidget QAbstractItemView:disabled { color: #c5c9d2; }

/* ---- tabla ---- */
QTableWidget { border: none; background: #ffffff; alternate-background-color: #fafbfc; selection-background-color: #fdf2f6; selection-color: #111827; outline: 0; }
QHeaderView::section { background: #ffffff; border: none; border-bottom: 1px solid #e6e8ee; padding: 8px; font-size: 11px; font-weight: 700; color: #6b7280; }</string>
