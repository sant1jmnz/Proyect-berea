  <property name="styleSheet">
   <string notr="true">QWidget { font-family: &quot;Lato&quot;; font-size: 14px; color: #3A2B2B; }
QWidget#central { background: #FAF5EE; }

/* ---- barra lateral ---- */
QFrame#barraLateral { background: #F3EAE0; border: none; border-right: 1px solid #E8DCCF; }
QLabel#lblLogo { font-family: &quot;Playfair Display&quot;; font-size: 22px; color: #8A6A3B; border: 1px solid #B8935A; border-radius: 22px; }
QLabel#lblMarca { font-family: &quot;Playfair Display&quot;; font-size: 24px; font-weight: 600; }
QLabel#lblSubmarca { color: #8A6A3B; font-size: 10px; font-weight: 700; }
QFrame#lineaMarca { background: #D9C3A0; border: none; }
QListWidget#menu { background: transparent; border: none; outline: 0; }
QListWidget#menu::item { padding: 11px 12px; border: 1px solid transparent; border-radius: 10px; color: #6B5B57; margin-bottom: 3px; }
QListWidget#menu::item:hover { background: #EBDFD3; }
QListWidget#menu::item:selected { background: #FFFDFA; border: 1px solid #E8DCCF; color: #A8475F; }
QLabel#lblPie { color: #7A6A64; font-size: 12px; }
QPushButton#btnAyuda { background: transparent; }

/* ---- textos ---- */
QLabel[rol=&quot;titulo&quot;] { font-family: &quot;Playfair Display&quot;; font-size: 30px; font-weight: 600; }
QLabel[rol=&quot;subtitulo&quot;] { color: #7A6A64; }
QLabel[rol=&quot;seccion&quot;] { font-family: &quot;Playfair Display&quot;; font-size: 18px; font-weight: 600; }
QLabel[rol=&quot;campo&quot;] { color: #8A6A3B; font-size: 11px; font-weight: 700; }
QLabel[rol=&quot;valor&quot;] { font-weight: 700; }
QLabel[rol=&quot;nota&quot;] { color: #7A6A64; font-size: 12px; }
QLabel[rol=&quot;numero&quot;] { font-size: 32px; font-weight: 700; color: #A8475F; }

/* ---- indicador de pasos ---- */
QLabel[paso=&quot;activo&quot;] { font-weight: 700; border: none; border-bottom: 2px solid #B8935A; padding: 4px 2px 6px 2px; }
QLabel[paso=&quot;hecho&quot;] { color: #A8475F; border: none; border-bottom: 2px solid #E8C9D0; padding: 4px 2px 6px 2px; }
QLabel[paso=&quot;pendiente&quot;] { color: #7A6A64; border: none; border-bottom: 2px solid #E8DCCF; padding: 4px 2px 6px 2px; }

/* ---- tarjetas ---- */
QFrame[tarjeta=&quot;true&quot;] { background: #FFFDFA; border: 1px solid #E8DCCF; border-radius: 14px; }
QFrame#tarjetaSena { background: #FBF3E6; border: 1px solid #E5D2B0; }
QLabel#lblSena { font-size: 36px; font-weight: 700; color: #8A6A3B; }
QLabel#lblRecordatorio { color: #8E3A50; background: #F7E8EB; border-radius: 10px; padding: 8px 14px; }

/* ---- campos y botones ---- */
QLineEdit { border: 1px solid #E8DCCF; border-radius: 10px; padding: 9px 12px; background: #FFFFFF; selection-background-color: #A8475F; }
QLineEdit:focus { border-color: #A8475F; }
QPushButton { border: 1px solid #D9C3A0; border-radius: 18px; padding: 9px 22px; font-weight: 700; background: #FFFDFA; }
QPushButton:hover { background: #F3EAE0; }
QPushButton:focus { border-color: #A8475F; }
QPushButton[primario=&quot;true&quot;] { background: #A8475F; border-color: #A8475F; color: #FFFFFF; }
QPushButton[primario=&quot;true&quot;]:hover { background: #8E3A50; border-color: #8E3A50; }
QPushButton[peligro=&quot;true&quot;] { color: #A33A3A; border-color: #E3BFBF; }
QPushButton[peligro=&quot;true&quot;]:hover { background: #FBEFEF; }
QPushButton#btnSena { background: #8A6A3B; border-color: #8A6A3B; color: #FFFFFF; }
QPushButton#btnSena:checked { background: #5F7F63; border-color: #5F7F63; }
QPushButton:disabled { background: #EFE8E0; border-color: #E8DCCF; color: #A89C95; }

/* ---- listas ---- */
QListWidget#listaProtocolos, QListWidget#listaHorarios, QListWidget#listaProximos { border: none; outline: 0; background: transparent; }
QListWidget#listaProtocolos::item { border: 1px solid #E8DCCF; border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; background: #FFFFFF; }
QListWidget#listaProtocolos::item:hover { border-color: #D9A9B4; }
QListWidget#listaProtocolos::item:selected { border-color: #A8475F; background: #F7E8EB; color: #3A2B2B; }
QListWidget#listaHorarios::item { border: 1px solid #E8DCCF; border-radius: 18px; padding: 9px 24px; margin-right: 8px; margin-bottom: 8px; background: #FFFFFF; }
QListWidget#listaHorarios::item:hover { border-color: #D9A9B4; }
QListWidget#listaHorarios::item:selected { border-color: #A8475F; background: #A8475F; color: #FFFFFF; }
QListWidget#listaProximos::item { padding: 11px 2px; border-bottom: 1px solid #F0E7DC; }

/* ---- calendario ---- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #FFFDFA; }
QCalendarWidget QToolButton { color: #3A2B2B; font-weight: 700; background: transparent; border: none; border-radius: 6px; padding: 4px 8px; }
QCalendarWidget QToolButton:hover { background: #F7E8EB; }
QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: none; qproperty-text: &quot;‹&quot;; font-size: 20px; }
QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: none; qproperty-text: &quot;›&quot;; font-size: 20px; }
QCalendarWidget QAbstractItemView { background: #FFFDFA; alternate-background-color: #FFFDFA; selection-background-color: #A8475F; selection-color: #FFFFFF; outline: 0; border: none; }
QCalendarWidget QAbstractItemView:disabled { color: #CFC4BA; }

/* ---- tablas ---- */
QTableWidget#tablaTurnos { font-size: 13px; }
QTableWidget { border: none; background: #FFFDFA; alternate-background-color: #FBF6EF; selection-background-color: #F7E8EB; selection-color: #3A2B2B; outline: 0; }
QHeaderView::section { background: #FFFDFA; border: none; border-bottom: 1px solid #D9C3A0; padding: 8px; font-size: 11px; font-weight: 700; color: #8A6A3B; }

/* ---- barras de desplazamiento ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #DCCFC0; border-radius: 3px; min-height: 30px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #DCCFC0; border-radius: 3px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }</string>
