  <property name="styleSheet">
   <string notr="true">QWidget { font-family: &quot;Lato&quot;; font-size: 18px; color: #3A2B2B; }
QWidget#central { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FCF8F2, stop:1 #F5ECE6); }

/* ---- franja de arriba ---- */
QFrame#barraSuperior { background: #F3EAE0; border: none; border-bottom: 1px solid #E8DCCF; }
QLabel#lblLogo { font-family: &quot;Playfair Display&quot;; font-size: 24px; color: #8A6A3B; border: 1px solid #B8935A; border-radius: 24px; }
QLabel#lblMarca { font-family: &quot;Playfair Display&quot;; font-size: 26px; font-weight: 600; }
QLabel#lblSubmarca { color: #8A6A3B; font-size: 11px; font-weight: 700; }
QPushButton#btnAyuda { background: transparent; }

/* ---- textos ---- */
QLabel[rol=&quot;titulo&quot;] { font-family: &quot;Playfair Display&quot;; font-size: 38px; font-weight: 600; }
QLabel[rol=&quot;subtitulo&quot;] { color: #7A6A64; }
QLabel[rol=&quot;seccion&quot;] { font-family: &quot;Playfair Display&quot;; font-size: 22px; font-weight: 600; }
QLabel[rol=&quot;campo&quot;] { color: #8A6A3B; font-size: 13px; font-weight: 700; }
QLabel[rol=&quot;valor&quot;] { font-weight: 700; }
QLabel[rol=&quot;nota&quot;] { color: #7A6A64; font-size: 15px; }
QLabel[rol=&quot;hora&quot;] { font-weight: 700; }
QLabel[rol=&quot;apagado&quot;] { color: #A89C95; }

/* ---- indicador de pasos ---- */
QLabel[paso=&quot;activo&quot;] { font-weight: 700; border: none; border-bottom: 3px solid #B8935A; padding: 6px 2px 8px 2px; }
QLabel[paso=&quot;hecho&quot;] { color: #A8475F; border: none; border-bottom: 3px solid #E8C9D0; padding: 6px 2px 8px 2px; }
QLabel[paso=&quot;pendiente&quot;] { color: #7A6A64; border: none; border-bottom: 3px solid #E8DCCF; padding: 6px 2px 8px 2px; }

/* ---- tarjetas ---- */
QFrame[tarjeta=&quot;true&quot;] { background: #FFFDFA; border: 1px solid #F0E7DC; border-radius: 14px; }
QFrame[fila=&quot;true&quot;] { background: transparent; border: none; border-bottom: 1px solid #F3EBE1; border-radius: 0; }

/* ---- bienvenida ---- */
QFrame#hero { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #9C3F57, stop:1 #C27A8B); border: none; border-radius: 16px; }
QFrame#hero QLabel { color: #FFFFFF; background: transparent; }
QFrame#hero QLabel#lblHeroEtiqueta { color: #F6DDE3; font-size: 13px; font-weight: 700; }
QFrame#hero QLabel#lblHeroTitulo { font-family: &quot;Playfair Display&quot;; font-size: 34px; font-weight: 600; }
QFrame#hero QLabel#lblHeroDetalle { color: #F9E9ED; }
QFrame#hero QPushButton#btnSacarTurno { background: #FFFDFA; border-color: #FFFDFA; color: #8E3A50; font-size: 20px; }
QFrame#hero QPushButton#btnSacarTurno:pressed { background: #F7E8EB; }

/* ---- números de paso y etiquetas ---- */
QLabel[avatar=&quot;rosa&quot;] { background: #F7E8EB; color: #8E3A50; border-radius: 22px; font-weight: 700; }
QLabel[avatar=&quot;dorado&quot;] { background: #FBF3E6; color: #8A6A3B; border-radius: 22px; font-weight: 700; }
QLabel[avatar=&quot;salvia&quot;] { background: #EAF1EA; color: #4F6B53; border-radius: 22px; font-weight: 700; }
QLabel[etiqueta=&quot;ok&quot;] { background: #EAF1EA; color: #4F6B53; border-radius: 14px; padding: 4px 14px; font-size: 14px; font-weight: 700; }
QLabel[etiqueta=&quot;pendiente&quot;] { background: #FBF3E6; color: #8A6A3B; border-radius: 14px; padding: 4px 14px; font-size: 14px; font-weight: 700; }
QFrame#tarjetaSena { background: #FBF3E6; border: 1px solid #E5D2B0; }
QLabel#lblSena { font-size: 44px; font-weight: 700; color: #8A6A3B; }
QLabel#lblRecordatorio { color: #8E3A50; background: #F7E8EB; border-radius: 10px; padding: 12px 16px; }

/* ---- campos y botones: todo lo que se toca mide 56 px o más ---- */
QLineEdit { border: 1px solid #E8DCCF; border-radius: 12px; padding: 14px 16px; min-height: 26px; background: #FFFFFF; selection-background-color: #A8475F; }
QLineEdit:focus { border-color: #A8475F; }
QPushButton { border: 1px solid #D9C3A0; border-radius: 29px; padding: 12px 30px; min-height: 34px; font-weight: 700; background: #FFFDFA; }
QPushButton:pressed { background: #F3EAE0; }
QPushButton[primario=&quot;true&quot;] { background: #A8475F; border-color: #A8475F; color: #FFFFFF; }
QPushButton[primario=&quot;true&quot;]:pressed { background: #8E3A50; border-color: #8E3A50; }
QPushButton[peligro=&quot;true&quot;] { color: #A33A3A; border-color: #E3BFBF; }
QPushButton[peligro=&quot;true&quot;]:pressed { background: #FBEFEF; }
QPushButton[opcion=&quot;true&quot;] { border: 1px solid #F0E7DC; border-radius: 16px; padding: 20px 22px; min-height: 84px; text-align: left; }
QPushButton[opcion=&quot;true&quot;]:pressed { background: #F7E8EB; border-color: #A8475F; }
QPushButton#btnSena { background: #8A6A3B; border-color: #8A6A3B; color: #FFFFFF; }
QPushButton#btnSena:checked { background: #5F7F63; border-color: #5F7F63; }
QPushButton:disabled { background: #EFE8E0; border-color: #E8DCCF; color: #A89C95; }

/* ---- listas ---- */
QListWidget#listaProtocolos, QListWidget#listaHorarios { border: none; outline: 0; background: transparent; }
QListWidget#listaProtocolos::item { border: 1px solid #E8DCCF; border-radius: 14px; padding: 16px 20px; margin-bottom: 14px; background: #FFFFFF; }
QListWidget#listaProtocolos::item:selected { border-color: #A8475F; background: #F7E8EB; color: #3A2B2B; }
QListWidget#listaHorarios::item { border: 1px solid #E8DCCF; border-radius: 28px; padding: 16px 30px; margin-right: 14px; margin-bottom: 14px; background: #FFFFFF; }
QListWidget#listaHorarios::item:selected { border-color: #A8475F; background: #A8475F; color: #FFFFFF; }

/* ---- calendario ---- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #FFFDFA; }
QCalendarWidget QToolButton { color: #3A2B2B; font-weight: 700; background: transparent; border: none; border-radius: 8px; padding: 10px 14px; }
QCalendarWidget QToolButton:pressed { background: #F7E8EB; }
QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: none; qproperty-text: &quot;‹&quot;; font-size: 28px; }
QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: none; qproperty-text: &quot;›&quot;; font-size: 28px; }
QCalendarWidget QAbstractItemView { background: #FFFDFA; alternate-background-color: #FFFDFA; selection-background-color: #A8475F; selection-color: #FFFFFF; outline: 0; border: none; font-size: 16px; }
QCalendarWidget QAbstractItemView:disabled { color: #CFC4BA; }

/* ---- barras de desplazamiento ---- */
QScrollBar:vertical { background: transparent; width: 14px; margin: 2px; }
QScrollBar::handle:vertical { background: #DCCFC0; border-radius: 5px; min-height: 40px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }</string>
