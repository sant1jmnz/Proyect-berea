/* Estilos globales para la Terminal Táctil de Dermalia */

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #2c2c2c;
    background-color: #faf9f9;
}

QMainWindow {
    background-color: #f4f2f3;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Campos de texto táctiles */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #d5d0d2;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #2c2c2c;
}

QLineEdit:focus {
    border: 2px solid #8e2a59;
    background-color: #ffffff;
}

/* DateEdit y ComboBox */
QDateEdit, QComboBox {
    background-color: #ffffff;
    border: 1.5px solid #d5d0d2;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #2c2c2c;
}

QDateEdit:focus, QComboBox:focus {
    border: 2px solid #8e2a59;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #d5d0d2;
}

/* Botones genéricos */
QPushButton {
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* Scrollbars estilizadas */
QScrollBar:vertical {
    border: none;
    background: #eae8e9;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #c2bac0;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #8e2a59;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
