{
  "name": "Dermalia - Enviar avisos por Telegram",
  "nodes": [
    {
      "id": "a1",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "a2",
      "name": "Consultar avisos",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL notificaciones.sp_notificaciones_telegram(500)",
        "options": {}
      },
      "credentials": {
        "mySql": {
          "id": "cred-mysql",
          "name": "MySQL Dermalia (dermalia_n8n)"
        }
      }
    },
    {
      "id": "a3",
      "name": "¿Chat válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ /^-?\\d+$/.test(String($json.telegram_chat_id ?? '')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a4",
      "name": "Enviar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        -100
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=Dermalia: {{ $json.mensaje }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Bot de Telegram de Dermalia"
        }
      }
    },
    {
      "id": "a5",
      "name": "Marcar enviada",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        900,
        -180
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL notificaciones.sp_marcar_notificacion($1, 'enviada', NULL)",
        "options": {
          "queryReplacement": "={{ [$('Avisos de Telegram pendientes').item.json.id_notificacion] }}"
        }
      },
      "credentials": {
        "mySql": {
          "id": "cred-mysql",
          "name": "MySQL Dermalia (dermalia_n8n)"
        }
      }
    },
    {
      "id": "a6",
      "name": "Marcar fallida (Telegram dio error)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        900,
        -20
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL notificaciones.sp_marcar_notificacion($1, 'fallida', $2)",
        "options": {
          "queryReplacement": "={{ [$('Avisos de Telegram pendientes').item.json.id_notificacion, String($json.error?.message ?? $json.error ?? 'Error de Telegram').slice(0, 400)] }}"
        }
      },
      "credentials": {
        "mySql": {
          "id": "cred-mysql",
          "name": "MySQL Dermalia (dermalia_n8n)"
        }
      }
    },
    {
      "id": "a7",
      "name": "Marcar fallida (chat inventado)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        660,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL notificaciones.sp_marcar_notificacion($1, 'fallida', 'El chat de Telegram no es válido')",
        "options": {
          "queryReplacement": "={{ [$json.id_notificacion] }}"
        }
      },
      "credentials": {
        "mySql": {
          "id": "cred-mysql",
          "name": "MySQL Dermalia (dermalia_n8n)"
        }
      }
    },
    {
      "id": "a2b",
      "name": "Avisos de Telegram pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        330,
        -140
      ],
      "parameters": {
        "jsCode": "// El nodo MySQL devuelve un CALL como [filas, paquete OK]: se aplanan las filas.\nconst filas = $input.all().map((i) => i.json).find((j) => Array.isArray(j)) ?? [];\nreturn filas.map((f) => ({ json: f }));"
      }
    }
  ],
  "connections": {
    "Cada minuto": {
      "main": [
        [
          {
            "node": "Consultar avisos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisos de Telegram pendientes": {
      "main": [
        [
          {
            "node": "¿Chat válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Chat válido?": {
      "main": [
        [
          {
            "node": "Enviar por Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Marcar fallida (chat inventado)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar por Telegram": {
      "main": [
        [
          {
            "node": "Marcar enviada",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Marcar fallida (Telegram dio error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar avisos": {
      "main": [
        [
          {
            "node": "Avisos de Telegram pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}