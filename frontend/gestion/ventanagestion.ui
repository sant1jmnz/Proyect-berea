  <property name="styleSheet">
   <string notr="true">QWidget { font-size: 13px; color: #1f2937; }
QMainWindow, QStackedWidget, QWidget#central { background: #ffffff; }

QListWidget#menu { background: #fdf2f6; border: none; border-right: 1px solid #e3e6eb; padding: 10px 8px; outline: 0; }
QListWidget#menu::item { padding: 9px 10px; border-radius: 7px; color: #4b5563; }
QListWidget#menu::item:selected { background: #d6136c; color: #ffffff; }

QLabel[rol="titulo"] { font-size: 19px; font-weight: 700; }
QLabel[rol="paso"] { color: #6b7280; font-weight: 600; }
QLabel[rol="nota"] { color: #6b7280; font-size: 12px; }
QLabel[rol="campo"] { color: #6b7280; font-size: 11px; font-weight: 600; }
QLabel[rol="valor"] { font-weight: 600; }

QLineEdit { border: 1px solid #e3e6eb; border-radius: 7px; padding: 7px 10px; background: #f4f5f7; }
QLineEdit:focus { border-color: #d6136c; }

QPushButton { border: 1px solid #d6136c; border-radius: 6px; padding: 8px 16px; font-weight: 600; color: #b80f5c; background: #ffffff; }
QPushButton[primario="true"] { background: #d6136c; color: #ffffff; }
QPushButton:disabled { background: #eceef2; border-color: #e3e6eb; color: #6b7280; }

QListWidget#listaProtocolos, QListWidget#listaHorarios { border: none; outline: 0; background: #ffffff; }
QListWidget#listaProtocolos::item { border: 1px solid #e3e6eb; border-radius: 9px; padding: 10px 14px; margin-bottom: 8px; }
QListWidget#listaProtocolos::item:selected { border-color: #d6136c; background: #fdf2f6; color: #1f2937; }
QListWidget#listaHorarios::item { border: 1px solid #e3e6eb; border-radius: 7px; padding: 10px 22px; margin-right: 8px; margin-bottom: 8px; }
QListWidget#listaHorarios::item:selected { border-color: #2563eb; background: #eef3ff; color: #2563eb; }

QFrame#tarjetaSena { border: 1px solid #2563eb; border-radius: 9px; background: #eef3ff; }
QFrame#tarjetaSena QLabel, QFrame#tarjetaSena QCheckBox { background: transparent; }
QLabel#lblSena { font-size: 18px; font-weight: 700; color: #2563eb; }
QLabel#lblRecordatorio { color: #8f0c48; background: #fdf2f6; border-radius: 6px; padding: 7px 10px; }</string>
